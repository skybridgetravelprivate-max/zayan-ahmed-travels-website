# Optional public banner for staging/test hosts (e.g. "TEST WEBSITE — Staging Environment").
# Leave unset on production. Visible in the header area when set.
NEXT_PUBLIC_SITE_NOTICE=

# Server-only. Do not prefix these with NEXT_PUBLIC_.
# Public site origin for canonical URLs, Open Graph, robots.txt, and the sitemap.
# Leave unset on production (defaults to https://www.zayanahmedtravels.com).
# On staging/test hosts, set to that host origin (e.g. https://example.hostingersite.com).
# Indexing is allowed only when this origin matches production.
SITE_URL=

# CRM_API_URL is a local fallback; production prefers the embedded API. Inquiry forms also require the CRM identifier/password.
CRM_API_URL=
CRM_API_IDENTIFIER=
CRM_API_PASSWORD=

# Server-to-server token for GET /api/account/bookings → CRM GET /v1/customer/bookings
# and POST /v1/customer/upsert-by-email (email identity link).
# Must match CRM CUSTOMER_BOOKINGS_INTERNAL_TOKEN (≥32 characters). Never use NEXT_PUBLIC_*.
CUSTOMER_BOOKINGS_INTERNAL_TOKEN=

# Website customer accounts and CRM data use separate PostgreSQL tables.
# Configure the existing Supabase connection privately; TLS verification is required.
DATABASE_URL=
DATABASE_SSL_CA=

# Production writes fail closed until explicitly enabled after the cutover preflight.
CUSTOMER_WRITES_ENABLED=false

# Production upload writes are hard-disabled until a durable private provider is implemented and verified.
UPLOAD_WRITES_ENABLED=false
