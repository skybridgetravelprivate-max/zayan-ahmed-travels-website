# Server-only. Do not prefix these with NEXT_PUBLIC_.
# Public site origin for canonical URLs, Open Graph, robots.txt, and the sitemap.
# Leave unset on production (defaults to https://www.zayanahmedtravels.com).
# On staging/test hosts, set to that host origin (e.g. https://example.hostingersite.com).
# Indexing is allowed only when this origin matches production.
SITE_URL=

# The public company profile reads CRM_API_URL only. It does not use the identifier or password.
# Contact, group-booking, corporate, Umrah, visa, tour, and transport forms create a CRM lead only when all three are set.
CRM_API_URL=
CRM_API_IDENTIFIER=
CRM_API_PASSWORD=

# Server-to-server token for GET /api/account/bookings → CRM GET /v1/customer/bookings.
# Must match CRM CUSTOMER_BOOKINGS_INTERNAL_TOKEN (≥32 characters). Never use NEXT_PUBLIC_*.
CUSTOMER_BOOKINGS_INTERNAL_TOKEN=

# Local SQLite file for future customer accounts. Server-only.
# Not a CRM setting. Do not point this at the CRM or another hosted database.
# Example for this machine: data/customers.sqlite
CUSTOMER_DATABASE_PATH=
