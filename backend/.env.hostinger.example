# Production overlay — copy into Hostinger environment variables (do not commit secrets)

NODE_ENV=production
START_MODE=all

# Public URL of this Node app (https://yourdomain.com)
APP_URL=https://YOUR-DOMAIN.com

# Internal Nest bind address — IP only, NOT your website URL
API_HOST=127.0.0.1
API_PORT=4000
API_URL=http://127.0.0.1:4000

# Empty = browser uses same-origin /api (required for login cookies)
NEXT_PUBLIC_API_URL=

COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# PostgreSQL — Hostinger VPS Postgres, or Neon/Supabase connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/zat_erp?schema=public&sslmode=require

JWT_SECRET=GENERATE-A-LONG-RANDOM-STRING
JWT_REFRESH_SECRET=GENERATE-ANOTHER-LONG-RANDOM-STRING

SEED_ADMIN_EMAIL=admin@YOUR-DOMAIN.com
SEED_ADMIN_PASSWORD=CHANGE-THIS-BEFORE-SEED
SEED_ADMIN_USERNAME=superadmin

STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@YOUR-DOMAIN.com
SMTP_SECURE=true

# Server-to-server token for website My Bookings + customer upsert (>=32 chars). Must match website CUSTOMER_BOOKINGS_INTERNAL_TOKEN.
CUSTOMER_BOOKINGS_INTERNAL_TOKEN=


# Optional loopback binding for isolated packaged-gateway validation only.
# Production keeps the existing 0.0.0.0 default when unset.
# GATEWAY_HOST=127.0.0.1
