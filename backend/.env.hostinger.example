# Production environment names only. Set real values privately in Hostinger.
NODE_ENV=production
APP_URL=https://zayanahmedtravels.com,https://www.zayanahmedtravels.com
DATABASE_URL=postgresql://user:password@host:5432/database?schema=public
DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...
JWT_SECRET=GENERATE-A-UNIQUE-RANDOM-SECRET
JWT_REFRESH_SECRET=GENERATE-A-DIFFERENT-RANDOM-SECRET

# Use false during cutover; enable only after database health and account smoke tests pass.
CUSTOMER_WRITES_ENABLED=false

# Production upload writes are hard-disabled until a durable private provider is implemented and verified.
UPLOAD_WRITES_ENABLED=false

COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Existing website/backend shared token; do not rotate during deployment.
CUSTOMER_BOOKINGS_INTERNAL_TOKEN=

# Leave the fallback URL unset for the embedded production API.
# Local development may set CRM_API_URL to a separate API origin.
# CRM_API_URL=
CRM_API_IDENTIFIER=
CRM_API_PASSWORD=
