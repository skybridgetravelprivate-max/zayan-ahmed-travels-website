{
  "name": "zat-erp",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "description": "Zayan Ahmed Travels (Pvt.) Ltd. — Travel + Umrah ERP/CRM",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @zat/api",
    "dev:web": "npm run dev -w @zat/web",
    "build": "npm run db:generate && npm run build --workspaces --if-present",
    "start": "node scripts/hostinger-start.cjs",
    "start:api": "npm run start -w @zat/api",
    "start:web": "npm run start -w @zat/web",
    "db:generate": "npm run generate -w @zat/database",
    "db:migrate": "npm run migrate -w @zat/database",
    "db:migrate:deploy": "npm run migrate:deploy -w @zat/database",
    "db:integrity": "npm run integrity -w @zat/database",
    "db:seed": "npm run seed -w @zat/database",
    "db:push": "npm run push -w @zat/database",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run db:generate && npx tsc -p apps/api/tsconfig.json --noEmit && npx tsc -p apps/web/tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "npx tsx scripts/e2e-api.mjs",
    "deploy:shared-crm": "node scripts/deploy-shared-crm.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "^8.5.30"
  }
}
