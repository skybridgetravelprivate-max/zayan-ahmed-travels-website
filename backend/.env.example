# Database — PostgreSQL required (Hostinger VPS / Neon / Supabase). Shared Hostinger MySQL will not work.
DATABASE_URL=postgresql://zat:zat_dev_password@localhost:5432/zat_erp?schema=public

# Redis (optional; not required to boot)
REDIS_URL=redis://localhost:6379

# Auth — use long random strings in production
JWT_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Apps
# Public site URL (comma-separated if you have www + apex)
APP_URL=http://localhost:3000
# Nest bind port. On Hostinger keep 4000; the public PORT is used by Next.js.
API_URL=http://127.0.0.1:4000
API_PORT=4000
API_HOST=127.0.0.1
WEB_PORT=3000
NODE_ENV=development

# Leave NEXT_PUBLIC_API_URL empty in production so the browser calls same-origin /api (rewritten to Nest).
NEXT_PUBLIC_API_URL=

# Server-to-server token for GET /v1/customer/bookings (website My Bookings). Min 32 chars. Must match website CUSTOMER_BOOKINGS_INTERNAL_TOKEN.
CUSTOMER_BOOKINGS_INTERNAL_TOKEN=

# Seed admin — required for `npm run db:seed`. Never commit a real password.
SEED_ADMIN_EMAIL=admin@zayanahmedtravels.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=superadmin

# Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=zat-documents
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@zayanahmedtravels.local
SMTP_SECURE=false

# WhatsApp Business API
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Cookies — on HTTPS Hostinger set COOKIE_SECURE=true. Leave COOKIE_DOMAIN empty for same-origin.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Hostinger / PM2: all | web | api
START_MODE=all

# Authorized reference CRM inspection ONLY (never commit real values; never ship to frontend)
# Used by agents/scripts to log into http://test.etravelcrm.com/CRM/Login.aspx for UX/workflow study.
# DO NOT put these in Horizons, PocketBase, README, logs, or production.
REFERENCE_CRM_USERNAME=
REFERENCE_CRM_PASSWORD=
