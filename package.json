{
  "name": "zayan-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:hostinger",
    "build:website": "next build --webpack && node scripts/package-hostinger.cjs",
    "test:inquiries": "node --conditions=react-server --import ./backend/node_modules/tsx/dist/loader.mjs --test src/server/crm-lead.test.ts src/lib/inquiries.test.ts",
    "build:hostinger": "npm ci --prefix backend && npm run build --prefix backend && npm run build:website",
    "start": "node backend/server.js",
    "lint": "eslint src",
    "test:customer-bookings": "node --conditions=react-server --import ./backend/node_modules/tsx/dist/loader.mjs --test src/server/customer-bookings/dto.test.ts src/server/customer-bookings/fetch.test.ts src/lib/account-bookings.test.ts",
    "test:customer-auth": "node --conditions=react-server --import ./backend/node_modules/tsx/dist/loader.mjs --test src/server/customer-auth/customer-auth.test.ts src/server/customer-auth/crm-link.test.ts src/server/customer-auth/rate-limit.test.ts",
    "test:account:pg17": "node --conditions=react-server --import ./backend/node_modules/tsx/dist/loader.mjs --test src/server/customer-bookings/account-journey.pg17.test.ts",
    "test:receipt-retry": "node --import ./backend/node_modules/tsx/dist/loader.mjs --test src/lib/receipt-retry.test.ts",
    "test:staff": "node --conditions=react-server --import ./backend/node_modules/tsx/dist/loader.mjs --test src/server/staff-api.test.ts src/lib/staff-leads.test.ts src/lib/staff-management.test.ts src/lib/staff-crm.test.ts",
    "test:website-presentation": "node --test scripts/production-presentation.test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "@types/pg": "^8.23.1"
  },
  "overrides": {
    "postcss": "^8.5.30",
    "braces": "npm:@dieub/braces-depth-guard@3.0.3-pn.0",
    "postcss-selector-parser": "^7.1.6",
    "zod": "4.6.6"
  }
}
