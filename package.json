{
  "name": "zayan-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:hostinger",
    "build:website": "next build --webpack",
    "build:hostinger": "npm ci --prefix backend && npm run build --prefix backend && npm prune --omit=dev --omit=optional --include=prod --prefix backend && npm run build:website",
    "start": "node .next/standalone/server.js",
    "lint": "eslint src",
    "test:customer-bookings": "node --conditions=react-server --import ./backend/node_modules/tsx/dist/loader.mjs --test src/server/customer-bookings/dto.test.ts src/server/customer-bookings/fetch.test.ts src/lib/account-bookings.test.ts",
    "test:customer-auth": "node --conditions=react-server --import ./backend/node_modules/tsx/dist/loader.mjs --test src/server/customer-auth/customer-auth.test.ts",
    "test:website-server": "node --conditions=react-server --import ./backend/node_modules/tsx/dist/loader.mjs --test src/server/customer-auth/customer-auth.test.ts src/server/api-proxy.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "@types/pg": "^8.23.1"
  },
  "overrides": {
    "postcss": "^8.5.30",
    "braces": "npm:@dieub/braces-depth-guard@3.0.3-pn.0",
    "postcss-selector-parser": "^7.1.6"
  }
}
