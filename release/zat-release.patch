+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { clearReceiptRetry, hasPendingReceipt, receiptRetryKey } from "./receipt-retry";
+
+function storage() {
+  const rows = new Map<string, string>();
+  return { rows, getItem: (key: string) => rows.get(key) ?? null, setItem: (key: string, value: string) => { rows.set(key, value); }, removeItem: (key: string) => { rows.delete(key); } };
+}
+
+test("receipt key survives a reload and reordered fields without storing payment data", async () => {
+  const session = storage();
+  const key = await receiptRetryKey(session, "staff", { bookingId: "private-booking", amount: 100, method: "CASH" });
+  // A new module/component instance reads the same session storage after reload.
+  assert.equal(await receiptRetryKey(session, "staff", { method: "CASH", amount: 100, bookingId: "private-booking" }), key);
+  assert.equal(hasPendingReceipt(session, "staff"), true);
+  assert.ok(!JSON.stringify([...session.rows]).includes("private-booking"));
+  assert.ok(!JSON.stringify([...session.rows]).includes("CASH"));
+});
+
+test("uncertain receipt blocks changed payloads until history review; staff namespaces stay separate", async () => {
+  const session = storage();
+  const key = await receiptRetryKey(session, "staff", { amount: 100 });
+  await assert.rejects(receiptRetryKey(session, "staff", { amount: 101 }), /earlier receipt is unconfirmed/);
+  assert.notEqual(await receiptRetryKey(session, "other", { amount: 101 }), key);
+  clearReceiptRetry(session, "staff");
+  assert.equal(hasPendingReceipt(session, "staff"), false);
+  assert.notEqual(await receiptRetryKey(session, "staff", { amount: 100 }), key);
+});
+
+test("receipt storage failures or corruption fail before submission, without replacing the prior key", async () => {
+  const session = storage();
+  const key = await receiptRetryKey(session, "staff", { amount: 100 });
+  const storageKey = [...session.rows.keys()][0];
+  session.rows.set(storageKey, "broken");
+  await assert.rejects(receiptRetryKey(session, "staff", { amount: 100 }), /retry information is unavailable/);
+  assert.equal(session.rows.get(storageKey), "broken");
+  assert.ok(key);
+  await assert.rejects(receiptRetryKey({ ...session, setItem: () => { throw Error("storage disabled"); } }, "new-staff", { amount: 100 }), /storage disabled/);
+});
diff --git a/src/lib/receipt-retry.ts b/src/lib/receipt-retry.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7ccb2e626be5551e261df50945ef7a9ffffcfc5c
--- /dev/null
+++ b/src/lib/receipt-retry.ts
@@ -0,0 +1,37 @@
+type RetryStorage = Pick<Storage, "getItem" | "setItem" | "removeItem">;
+const storageKey = (staffUsername: string) => `zat:pending-receipt:${staffUsername}`;
+
+export function hasPendingReceipt(storage: RetryStorage, staffUsername: string) {
+  return storage.getItem(storageKey(staffUsername)) !== null;
+}
+
+export function clearReceiptRetry(storage: RetryStorage, staffUsername: string) {
+  storage.removeItem(storageKey(staffUsername));
+}
+
+export function savedReceiptRetryKey(storage: RetryStorage, staffUsername: string): string | null {
+  const prior = storage.getItem(storageKey(staffUsername));
+  if (prior === null) return null;
+  const value = JSON.parse(prior);
+  if (!value || typeof value.key !== "string" || !/^[A-Za-z0-9_-]{8,100}$/.test(value.key)) throw new Error("Receipt retry information is unavailable. Review receipt history.");
+  return value.key;
+}
+
+/** Persist only a fingerprint and retry key, never receipt fields or credentials. */
+export async function receiptRetryKey(storage: RetryStorage, staffUsername: string, payload: Record<string, unknown>) {
+  const canonical = JSON.stringify(Object.fromEntries(Object.entries(payload).sort(([a], [b]) => a.localeCompare(b))));
+  const bytes = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(canonical));
+  const fingerprint = Array.from(new Uint8Array(bytes), byte => byte.toString(16).padStart(2, "0")).join("");
+  const key = storageKey(staffUsername);
+  const prior = storage.getItem(key);
+  if (prior !== null) {
+    let pending: { fingerprint?: unknown; key?: unknown };
+    try { pending = JSON.parse(prior); } catch { throw new Error("Receipt retry information is unavailable. Review receipt history before starting another payment."); }
+    if (!pending || pending.fingerprint !== fingerprint || typeof pending.key !== "string" || !/^[A-Za-z0-9_-]{8,100}$/.test(pending.key)) throw new Error("An earlier receipt is unconfirmed. Retry its original details, or review receipt history before starting another payment.");
+    return pending.key;
+  }
+  const pending = JSON.stringify({ fingerprint, key: crypto.randomUUID() });
+  storage.setItem(key, pending);
+  if (storage.getItem(key) !== pending) throw new Error("Receipt retry information could not be saved. Payment was not submitted.");
+  return (JSON.parse(pending) as { key: string }).key;
+}
